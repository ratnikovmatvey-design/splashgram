[Desktop Entry]
Name=Splashgram Desktop
Comment=Desktop version of Splashgram - ToS breaking Telegram client
TryExec=Splashgram
Exec=env DESKTOPINTEGRATION=1 Splashgram -- %U
Icon=com.splashgram.desktop
Terminal=false
StartupWMClass=Splashgram
Type=Application
Categories=Chat;Network;InstantMessaging;Qt;
MimeType=x-scheme-handler/tg;x-scheme-handler/tonsite;
Keywords=tg;chat;im;messaging;messenger;sms;telegram;tdesktop;
Actions=quit;
DBusActivatable=true
SingleMainWindow=true
X-GNOME-UsesNotifications=true
X-GNOME-SingleWindow=true

[Desktop Action quit]
Exec=Splashgram -quit
Name=Quit Splashgram
Icon=application-exit
